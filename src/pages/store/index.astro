		category: "Ventiladores Evaporativos",
		categorySlug: "ventiladores-evaporativos",
		image: BlogPlaceholder3,
	},
	{
		id: 4,
		slug: "aircool",
		name: "AirCool",
		category: "Ventiladores Industriales",
		categorySlug: "ventiladores-industriales",
		image: Grupo4030,
	},
	{
		id: 5,
		slug: "classic-r-xl",
		name: "Classic R XL",
		category: "Ventiladores Evaporativos",
		categorySlug: "ventiladores-evaporativos",
		image: BlogPlaceholder5,
	},
	{
		id: 6,
		slug: "eurus-iii",
		name: "Eurus III",
		category: "Ventiladores Industriales",
		categorySlug: "ventiladores-industriales",
		image: Grupo4036,
	},
	{
		id: 7,
		slug: "aircool-2",
