		slug: "classic-r-xl-2",
		name: "Classic R XL",
		category: "Ventiladores Evaporativos",
		categorySlug: "ventiladores-evaporativos",
		image: BlogPlaceholder5,
	},
	{
		id: 9,
		slug: "eurus-iii-2",
